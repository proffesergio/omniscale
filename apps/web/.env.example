# Copy to apps/web/.env.local. Never commit secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Generate independently with: openssl rand -hex 32
RATE_LIMIT_SECRET=
CRON_SECRET=
# Optional delivery adapter: generic (HMAC signed), slack, or discord
AUDIT_WEBHOOK_URL=
AUDIT_WEBHOOK_SECRET=
AUDIT_WEBHOOK_PROVIDER=generic
# Optional booking confirmation/update email delivery
RESEND_API_KEY=
BOOKING_FROM_EMAIL=
CONTACT_EMAIL=
# Only set if your reverse proxy overwrites this header; never trust arbitrary IP headers.
TRUSTED_IP_HEADER=
# Optional server-verified revenue evidence, never exposed as verified ROI.
STRIPE_SECRET_KEY=
STRIPE_PROOF_CHARGE_IDS=
